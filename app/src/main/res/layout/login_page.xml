<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="15dp">

        <!-- LOGIN TEXT -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOGIN"
            android:textColor="#8C8C8C"
            android:textSize="11sp"
            android:letterSpacing="0.35"
            android:layout_marginBottom="12dp"/>

        <!-- MAIN CARD -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="710dp"
            android:background="@drawable/auth_bg"
            android:padding="26dp">

            <!-- TOP CIRCLES -->
            <View
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-90dp"
                android:layout_marginEnd="-70dp"
                android:background="@drawable/circle_large"/>

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="-35dp"
                android:layout_marginEnd="-20dp"
                android:background="@drawable/circle_small"/>

            <!-- CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- LOGO -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="10dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:background="@drawable/logo_bg"
                    android:layout_marginBottom="34dp">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="@drawable/logo_circle"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" GetitDone"
                        android:textColor="#666666"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome"
                    android:textColor="#1F223A"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="back."
                    android:textColor="#2386F0"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sign in to your notes"
                    android:textColor="#8A8A8A"
                    android:textSize="14sp"
                    android:layout_marginBottom="26dp"/>

                <!-- EMAIL -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="EMAIL"
                    android:textColor="#4E596B"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:letterSpacing="0.28"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/loginEmail"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_active"
                    android:drawableStart="@android:drawable/ic_dialog_email"
                    android:drawablePadding="10dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingVertical="14dp"
                    android:textColorHint="#9E9E9E"
                    android:hint="you@email.com"
                    android:textColor="#444444"
                    android:backgroundTint="@null"
                    android:textSize="15sp"
                    android:layout_marginBottom="16dp"/>

                <!-- PASSWORD -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASSWORD"
                    android:textColor="#4E596B"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:letterSpacing="0.28"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/loginPassword"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/input_active"
                    android:drawableStart="@android:drawable/ic_lock_lock"
                    android:drawablePadding="10dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:hint="Password"
                    android:textColor="#444444"
                    android:textSize="15sp"
                    android:paddingVertical="14dp"
                    android:textColorHint="#9E9E9E"
                    android:backgroundTint="@null"
                    android:layout_marginBottom="18dp"/>

                <!-- LOGIN BTN -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/login"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Log in"
                    android:textAllCaps="false"
                    app:backgroundTint="@null"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:background="@drawable/blue_btn"
                    android:elevation="8dp"
                    android:layout_marginBottom="18dp"/>

                <!-- DIVIDER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="18dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E0E0E0"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="or continue with"
                        android:textColor="#B1B1B1"
                        android:textSize="12sp"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"
                        android:background="#E0E0E0"/>
                </LinearLayout>

                <!-- GOOGLE -->
                <LinearLayout
                    android:id="@+id/googleSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/google_btn"
                    android:layout_marginBottom="18dp">

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:background="@drawable/red_dot"/>

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/yellow_dot"/>

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/green_dot"/>

                    <View
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/blue_dot"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Google"
                        android:textColor="#666666"
                        android:textSize="15sp"/>
                </LinearLayout>>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <!-- FOOTER -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Don't have an account? "
                        android:textColor="#B1B1B1"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/goToSignUp"
                        android:clickable="true"
                        android:onClick="goToSignUpPage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign up →"
                        android:textColor="#2386F0"
                        android:textStyle="bold"
                        android:textSize="13sp"/>
                </LinearLayout>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

</ScrollView>